{
	"name": "negodesign",
	"version": "0.0.30",
	"type": "module",
	"license": "MIT",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/types/index.js"
		},
		"./i18n": {
			"types": "./dist/i18n/index.d.ts",
			"svelte": "./dist/i18n/index.js",
			"default": "./dist/i18n/index.js"
		},
		"./styles.css": "./dist/globals.css",
		"./*.svelte": "./dist/*.svelte",
		"./*": {
			"types": "./dist/*.d.ts",
			"svelte": "./dist/*.js",
			"default": "./dist/*.js"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"package": "svelte-kit sync && svelte-package && tailwindcss -i ./src/lib/styles/globals.css -o ./dist/globals.css",
		"prepublishOnly": "npm run package",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@dnd-kit-svelte/svelte": "^0.1.6",
		"@dnd-kit/abstract": "^0.5.0",
		"@dnd-kit/helpers": "^0.5.0",
		"@internationalized/date": "^3.12.2",
		"@tanstack/table-core": "^8.21.3",
		"@types/country-flag-icons": "^1.2.2",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.8",
		"bits-ui": "^2.18.1",
		"country-flag-icons": "^1.6.20",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"embla-carousel-autoplay": "^8.6.0",
		"embla-carousel-svelte": "^8.6.0",
		"layerchart": "^2.0.0-next.48",
		"mode-watcher": "^1.1.0",
		"runed": "^0.37.1",
		"svelte-sonner": "^1.1.1",
		"svelte-tel-input": "^4.3.2",
		"svelte-toolbelt": "^0.10.6",
		"tailwind-variants": "^3.3.0",
		"vaul-svelte": "^1.0.0-next.7",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/figtree": "^5.3.0",
		"@hugeicons/core-free-icons": "^4.2.3",
		"@hugeicons/svelte": "^1.1.4",
		"@lucide/svelte": "^1.28.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/cli": "^4.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.8",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"country-flag-icons": "^1.6.20",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"shadcn-svelte": "^1.4.2",
		"svelte": "^5.56.8",
		"svelte-check": "^4.6.0",
		"svelte-preprocess": "^6.0.5",
		"svelte-tel-input": "^4.3.2",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	}
}